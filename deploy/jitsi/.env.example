# =============================================================================
# EduTeach — cấu hình máy chủ Jitsi riêng
# SỬA các dòng dưới rồi lưu thành file .env (cùng thư mục docker-compose.yml)
# =============================================================================

# ── Tên miền (PHẢI trỏ bản ghi A về IP VPS) ──
# Dùng subdomain riêng: vd meet.tenban.com (hoặc free: duckdns.org)
XMPP_DOMAIN=meet.tenban.com
XMPP_AUTH_DOMAIN=auth.meet.tenban.com
XMPP_MUC_DOMAIN=muc.meet.tenban.com
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.tenban.com
XMPP_RECORDER_DOMAIN=recorder.meet.tenban.com
XMPP_GUEST_DOMAIN=guest.meet.tenban.com
XMPP_BOSH_URL_BASE=http://prosody:5280
XMPP_CROSS_DOMAIN=true
XMPP_MODULES=admin_websocket,bosh
XMPP_MUC_MODULES=muc_meeting_id,muc_domain_mapper
XMPP_INTERNAL_MUC_MODULES=muc_meeting_id,muc_domain_mapper

# ── HTTPS (Let's Encrypt — bắt buộc để WebView chấp nhận) ──
PUBLIC_URL=https://meet.tenban.com
ENABLE_HTTP_REDIRECT=1
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=meet.tenban.com
LETSENCRYPT_EMAIL=ban@email.com

# ── Tài khoản (0 = khách vào tự do với room UUID không đoán được;
#    muốn login nội bộ: ENABLE_AUTH=1 + AUTH_TYPE=internal + ENABLE_GUESTS=0) ──
ENABLE_AUTH=0
ENABLE_GUESTS=1
AUTH_TYPE=internal

# ── MẬT KHẨU NỘI BỘ — tạo bằng lệnh: openssl rand -hex 16 ──
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=THAY_BANG_MA_NGAU_NHIEN_1
JICOFO_COMPONENT_SECRET=THAY_BANG_MA_NGAU_NHIEN_2
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=THAY_BANG_MA_NGAU_NHIEN_3

# ── STUN + TURN (TURN riêng cho mạng di động VN) ──
JVB_STUN_SERVERS=meet-jit-si-turnrelay.jitsi.net:443
TURN_HOST=turn.meet.tenban.com        # trỏ bản ghi A về IP VPS
TURN_PORT=5349
TURN_TRANSPORT=tcp
TURN_SECRET=THAY_BANG_MA_NGAU_NHIEN_4
TURN_CREDENTIALS=eduteach:THAY_BANG_MA_NGAU_NHIEN_5

# ── JVB ──
JVB_PORT=10000
JVB_TCP_PORT=10000
JVB_TCP_MAPPED_PORT=10000
JVB_BREWERY_MUC=jvbbrewery
JVB_ENABLE_APIS=rest,xmpp
JVB_HTTP_API_PORT=8080
JICOFO_ENABLE_HEALTH_CHECKS=true

# ── Khác ──
CONFIG=./config
TZ=Asia/Ho_Chi_Minh
