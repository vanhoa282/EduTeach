{
  "expo": {
    "name": "EduTeach",
    "slug": "EduTeach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "eduteach",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vanhoa282.eduteach"
    },
    "android": {
      "package": "com.vanhoa282.eduteach",
      "icon": "./assets/icon.png",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dc90e3c4-6404-499c-9861-61f3b266d8b2"
      }
    },
    "owner": "vanhoa282"
  }
}
